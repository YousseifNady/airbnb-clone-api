APP_NAME="Airbnb Clone Api"
# Must Be: 'local' OR 'development' OR 'staging' OR 'production'
APP_ENV=local
APP_PORT=3000

MONGO_HOST="localhost"
MONGO_PORT=27017
MONGO_DB_NAME="airbnb-clone-api"

JWT_SECRET="YOUR JWT SECRET"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# Validation Pipe Configurations
VALIDATION_TRANSFORM=true
VALIDATION_WHITELIST=true
VALIDATION_FORBID_NON_WHITELISTED=true

SWAGGER_TITLE="Airbnb Clone API"
SWAGGER_DESCRIPTION="API documentation for Airbnb Clone project"
SWAGGER_VERSION="1.0.0"
SWAGGER_PATH="api/docs"

# Super Admin Account
SYSTEM_ADMIN_NAME="Super Admin"
SYSTEM_ADMIN_EMAIL="admin@airbnb.com"
SYSTEM_ADMIN_PASSWORD="password"