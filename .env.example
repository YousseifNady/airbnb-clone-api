# ==============================================================================
# [ Application Configuration ]
# ==============================================================================
# The name of the application.
APP_NAME="Airbnb Clone Api"

# The environment the application is running in.
# Accepted values: local, development, staging, production
APP_ENV=local

# The port on which the NestJS application will run. (Required)
APP_PORT=3000


# ==============================================================================
# [ Database Configuration (MongoDB) ]
# ==============================================================================
# The host address of the MongoDB server.
MONGO_HOST=localhost

# The port of the MongoDB server. (Required)
MONGO_PORT=27017

# The name of the MongoDB database.
MONGO_DB=airbnb-clone-api


# ==============================================================================
# [ Security & JWT Configuration ]
# ==============================================================================
# A strong secret key used to sign the JWT tokens. Keep this secure! (Required)
JWT_SECRET=your_super_secret_jwt_key_here

# General expiration time for JWTs (e.g., '1h', '7d'). (Required)
JWT_EXPIRES_IN=1h

# Expiration time specifically for the access token. (Required)
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# Expiration time specifically for the refresh token. (Required)
JWT_REFRESH_TOKEN_EXPIRES_IN=7d


# ==============================================================================
# [ Global Validation Pipe Configurations ]
# ==============================================================================
# Automatically transform payloads to be objects typed according to their DTO classes.
VALIDATION_TRANSFORM=true

# Strip validated object of any properties that do not use any validation decorators.
VALIDATION_WHITELIST=true

# Throw an error if non-whitelisted properties are present in the payload.
VALIDATION_FORBID_NON_WHITELISTED=true


# ==============================================================================
# [ Swagger (API Documentation) Configurations ]
# ==============================================================================
# The title displayed on the Swagger UI.
SWAGGER_TITLE="Airbnb Clone API"

# The description displayed on the Swagger UI.
SWAGGER_DESCRIPTION="The Airbnb Clone API description"

# The current version of the API documentation.
SWAGGER_VERSION="1.0.0"

# The endpoint route path where the Swagger UI will be accessible.
SWAGGER_PATH="api/docs"


# ==============================================================================
# [ System Administrator Seeder Data ]
# ==============================================================================
# Default system administrator credentials (used for initial DB seeding/setup).
# (Required)
SYSTEM_ADMIN_NAME="Super Admin"
SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=secure_password_here


# ==============================================================================
# [ Storage & AWS Configurations ]
# ==============================================================================
# The storage driver to use for file uploads. 
# Accepted values: file, s3 (Default: file)
STORAGE_DRIVER=file

# ------------------------------------------------------------------------------
# AWS S3 Settings
# IMPORTANT: The following 4 variables are strictly REQUIRED if STORAGE_DRIVER=s3
# ------------------------------------------------------------------------------
# The AWS region where your S3 bucket is hosted (e.g., us-east-1, eu-central-1).
AWS_REGION=us-east-1

# Your AWS IAM Access Key ID with S3 permissions.
AWS_ACCESS_KEY_ID=your_aws_access_key_id

# Your AWS IAM Secret Access Key.
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# The exact name of your AWS S3 bucket.
AWS_S3_BUCKET=your_s3_bucket_name